config.json
config.json.*
cache/
browser/
# personal sound files dropped in for testing
*.mp3
*.wav
*.flac
*.ogg
*.m4a
*.aac
*.wma
# editor / OS / tool state
.vscode/
.idea/
*.code-workspace
Thumbs.db
desktop.ini
.DS_Store
.claude/settings.local.json

# Tor Expert Bundle, unpacked by scripts/fetch_tor.py (never committed)
vendor/
