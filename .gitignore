# ---- never publish: secrets, personal data, local machine state
# (see SECURITY.md and CONTRIBUTING.md)
.sensitive-patterns
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.token
secrets.*
credentials*.json
*.log
*.log.[0-9]*
# app data copied from %APPDATA%\OnionBoard while debugging
config.json
config.json.*
cache/
browser/
# personal sound files dropped in for testing
*.mp3
!site/sounds/*.mp3
*.wav
*.flac
*.ogg
*.m4a
*.aac
*.wma
# editor / OS / tool state
.vscode/
.idea/
*.code-workspace
Thumbs.db
desktop.ini
.DS_Store
.claude/settings.local.json

