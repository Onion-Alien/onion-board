.venv/
__pycache__/
*.pyc
*.tmp
build/
dist/
*.spec
*.egg-info/
installer/*.bmp
installer/*.png
.pytest_cache/
.ruff_cache/

# ---- never publish: secrets, personal data, local machine state
# (see SECURITY.md and docs/PUBLIC-RELEASE-CHECKLIST.md)
.sensitive-patterns
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.token
secrets.*
credentials*.json
*.log
*.log.[0-9]*
# app data copied from %APPDATA%\Soundboard while debugging
config.json
config.json.*
cache/
browser/
# personal sound files dropped in for testing
*.mp3
*.wav
*.flac
*.ogg
*.m4a
*.aac
*.wma
# editor / OS / tool state
.vscode/
.idea/
*.code-workspace
Thumbs.db
desktop.ini
.DS_Store
.claude/settings.local.json
