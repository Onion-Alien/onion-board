# cmd.exe mis-parses labels/goto in LF-only batch files
*.bat text eol=crlf
*.cmd text eol=crlf
# git hooks are sh scripts: a CR breaks them
.githooks/* text eol=lf
*.sh text eol=lf
# the radio maps are checked against pinned SHA-384s: never rewrite their line endings
assets/radio/** -text

# translation catalogs merge by key, not by line (scripts/merge_json.py)
assets/lang/*.json merge=langjson
