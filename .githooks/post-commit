#!/bin/sh
# Re-stamps the new commit's times in UTC (+0000), so the history doesn't carry the
# committer's local timezone. Same tree, parents, author and message; only the
# offset changes (the moment in time is kept). Enabled with the pre-commit hook:
#   git config core.hooksPath .githooks
a=$(git log -1 --format=%ad --date=raw HEAD) || exit 0
c=$(git log -1 --format=%cd --date=raw HEAD) || exit 0
[ "${a##* }" = "+0000" ] && [ "${c##* }" = "+0000" ] && exit 0

old=$(git rev-parse HEAD)
set --
for p in $(git log -1 --format=%P HEAD); do set -- "$@" -p "$p"; done
new=$(git cat-file commit HEAD | sed '1,/^$/d' |
    GIT_AUTHOR_NAME=$(git log -1 --format=%an HEAD) \
    GIT_AUTHOR_EMAIL=$(git log -1 --format=%ae HEAD) \
    GIT_AUTHOR_DATE="${a%% *} +0000" \
    GIT_COMMITTER_NAME=$(git log -1 --format=%cn HEAD) \
    GIT_COMMITTER_EMAIL=$(git log -1 --format=%ce HEAD) \
    GIT_COMMITTER_DATE="${c%% *} +0000" \
    git commit-tree "$(git rev-parse HEAD^{tree})" "$@") || exit 0
git update-ref -m "post-commit: times in UTC" HEAD "$new" "$old" &&
    echo "(commit times recorded in UTC: $(git rev-parse --short HEAD))"
