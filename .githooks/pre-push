#!/bin/sh
# Refuses to push commits whose times aren't recorded in UTC (+0000): a commit's time
# zone tells everyone where its author is. Checks only what this push sends that the
# remote doesn't have yet. Fix with: sh scripts/utc_fix.sh
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r lref lsha rref rsha; do
    [ "$lsha" = "$zero" ] && continue          # deleting a branch
    if [ "$rsha" = "$zero" ]; then             # a new branch: what no remote has yet
        set -- "$lsha" --not --remotes
    else
        set -- "$rsha..$lsha"
    fi
    sh "$root/scripts/check_utc.sh" "$@" || status=1
done
[ $status -eq 0 ] || echo "Push refused: commit times must be in UTC (see CLAUDE.md, \"Commit times\")." >&2
exit $status
